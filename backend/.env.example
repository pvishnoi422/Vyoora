# AI is disabled until both this switch and the shared policy permit it.
AI_ENABLED=false
GOOGLE_CLOUD_PROJECT=vyoora-backend
FIRESTORE_DATABASE=(default)
# In Cloud Run this must be a mounted Secret Manager file.
OPENAI_API_KEY_FILE=/secrets/openai/api-key
# Only enable the one-hop rule on direct, platform-controlled Cloud Run ingress.
TRUSTED_PROXY_HOPS=1
# Native mobile clients do not need CORS. List exact web origins if deployed.
CORS_ORIGINS=
